ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# VEGA_PROVIDER and VEGA_MODEL are optional one-off overrides, not defaults —
# setting them here pins the provider/model on every launch and permanently
# shadows whatever you pick via /provider or /models (env vars win over the
# saved preference file, see src/config.ts's loadConfig precedence). Leave
# them unset unless you actually want that pin.
# VEGA_PROVIDER=
# VEGA_MODEL=
